# Your backend's address. The browser never calls it directly: this site forwards /api requests
# to it, which keeps the admin login working on phones. Used on the server only.
API_URL=http://localhost:4000
# Same random value as PROXY_SECRET on the backend (lets rate limits see each visitor's real IP).
PROXY_SECRET=3A6fo9ODtjuiRR57dWisdC4l8Bq60G3-
# Brand name shown in the header and page titles
NEXT_PUBLIC_SITE_NAME="The Chill Circle"
# Secret address for the admin dashboard (one word: letters, numbers, - or _). With
# ADMIN_PATH=door-9x2k the dashboard is at /door-9x2k and /admin shows "page not found".
# Leave empty to keep /admin. Redeploy after changing it.
ADMIN_PATH=
